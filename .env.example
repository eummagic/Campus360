# Supabase local development (from `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-anon-key

# Local seed script only — never expose to browser or commit real values
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas — app user (readWrite on campus360 only)
MONGODB_URI=mongodb+srv://campus360_app:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=campus360
# MongoDB Atlas — admin user for init/verify scripts only (dbAdmin + readWrite on campus360)
MONGODB_ADMIN_URI=mongodb+srv://campus360_admin:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=campus360
MONGODB_DB=campus360