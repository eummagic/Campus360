{
  "name": "campus360",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed:users": "node --env-file=.env.local --import tsx scripts/seed-users.ts",
    "db:seed:synthetic": "node --env-file=.env.local --import tsx scripts/seed-synthetic-campus.ts",
    "db:test": "supabase test db",
    "db:mongo:init": "node --env-file=.env.local --import tsx scripts/mongo/init-db.ts",
    "db:mongo:verify": "node --env-file=.env.local --import tsx scripts/mongo/verify-db.ts",
    "db:mongo:seed-auth": "node --env-file=.env.local --import tsx scripts/mongo/seed-auth-users.ts",
    "db:mongo:verify-auth": "node --env-file=.env.local --import tsx scripts/mongo/verify-auth.ts"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.13",
    "@google/genai": "^2.31.0",
    "@hookform/resolvers": "^3.10.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "better-auth": "1.7.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "mongodb": "7.7.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.22.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "supabase": "^2.19.7",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.8"
  }
}
